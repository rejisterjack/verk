generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum InitiativeHealth {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Priority {
  NONE
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum Estimate {
  NONE
  XS
  S
  M
  L
  XL
  XXL
  ONE
  TWO
  THREE
  FOUR
  FIVE
  EIGHT
  SIXTEEN
  THIRTEEN
}

enum ProjectStatus {
  BACKLOG
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkflowStatusType {
  backlog
  unstarted
  started
  completed
  canceled
}

enum RelationType {
  BLOCKS
  BLOCKED_BY
  RELATED
  PARENT
  CHILD
  DUPLICATE
  DUPLICATED_BY
}

enum NotificationType {
  ASSIGNED
  COMMENTED
  STATUS_CHANGED
  MENTIONED
  SUBSCRIBED
}

enum ViewLayout {
  LIST
  BOARD
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  disabled      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  memberships            Membership[]
  workspaceMembers       WorkspaceMember[]
  invitesSent            Invite[]                @relation("InvitedBy")
  workspaceInvitesSent   WorkspaceInvite[]       @relation("WorkspaceInvitedBy")
  issuesCreated          Issue[]                 @relation("IssueCreator")
  issuesAssigned         Issue[]                 @relation("IssueAssignee")
  apiKeys                ApiKey[]
  comments               Comment[]
  notifications          Notification[]
  issueSubscriptions     IssueSubscription[]
  notificationPreference NotificationPreference?
  issueDrafts            IssueDraft[]
  automationsCreated     Automation[]
  twoFactor              TwoFactor?
  insightReports         InsightReport[]
  passkeys               Passkey[]
  agentClaims            AgentClaim[]
  projectsLed            Project[]               @relation("ProjectLead")
  webhooksCreated        Webhook[]
  attachments            Attachment[]
  triageTeams            Team[]                  @relation("TriageOwner")
  activities             IssueActivity[]
  projectUpdates         ProjectUpdate[]
  documentsUpdated       Document[]
  triageRuleAssignees    TriageRule[]            @relation("TriageAssignee")
  documentComments       DocumentComment[]
  savedViews             SavedView[]
  statusRuleAssignees    StatusRule[]            @relation("StatusAssignee")
  issuePresence          IssuePresence[]
  favorites              Favorite[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  WorkspaceMember[]
  teams    Team[]
  projects Project[]
  invites  WorkspaceInvite[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(MEMBER)
  tokenHash   String    @unique
  expiresAt   DateTime
  invitedById String
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

model Team {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  issueCounter       Int      @default(0)
  workspaceId        String?
  cycleDurationWeeks Int      @default(2)
  cyclesEnabled      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  githubRepo           String?
  githubMergeCompletes Boolean @default(false)
  gitlabProject        String?
  slackWebhookUrl      String?
  slackTeamId          String?
  slackChannelId       String?
  /// Days to keep audit entries; 0 keeps them forever. Default one year.
  auditRetentionDays   Int     @default(365)
  slaHours             Json?
  timezone             String  @default("UTC")
  slaStartHour         Int     @default(0)
  slaEndHour           Int     @default(24)
  slaWeekdays          String  @default("1,2,3,4,5")
  cycleCooldownDays    Int     @default(0)
  triageOwnerId        String?
  isPrivate            Boolean @default(false)
  parentId             String?
  autoCloseParent      Boolean @default(false)
  subIssueInherit      Boolean @default(true)
  estimateScale        String  @default("fibonacci")

  parent            Team?             @relation("SubTeams", fields: [parentId], references: [id], onDelete: SetNull)
  children          Team[]            @relation("SubTeams")
  workspace         Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  memberships       Membership[]
  invites           Invite[]
  issues            Issue[]
  cycles            Cycle[]
  apiKeys           ApiKey[]
  mutationReceipts  MutationReceipt[]
  issueDeletions    IssueDeletion[]
  labels            Label[]
  projects          Project[]
  initiatives       Initiative[]
  savedViews        SavedView[]
  workflowStatuses  WorkflowStatus[]
  webhooks          Webhook[]
  auditLogs         AuditLog[]
  askLink           AskLink?
  insightReports    InsightReport[]
  oauthApps         OAuthApp[]
  webhookDeliveries WebhookDelivery[]
  issueDrafts       IssueDraft[]
  automations       Automation[]
  triageOwner       User?             @relation("TriageOwner", fields: [triageOwnerId], references: [id], onDelete: SetNull)
  templates         IssueTemplate[]
  documents         Document[]
  customers         Customer[]
  triageRules       TriageRule[]
  releases          Release[]
  pipelineStages    PipelineStage[]
  pipelines         Pipeline[]
  savedInsights     SavedInsight[]
  statusRules       StatusRule[]
  favorites         Favorite[]

  @@unique([slackTeamId, slackChannelId])
  @@index([slackTeamId])
  @@index([parentId])
}

model Membership {
  id              String   @id @default(cuid())
  userId          String
  teamId          String
  role            Role     @default(MEMBER)
  /// Guests only: when non-empty, the guest sees only issues in these projects. Empty = the
  /// whole team (the old behaviour). Ignored for members and above.
  guestProjectIds String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model Invite {
  id          String    @id @default(cuid())
  teamId      String
  email       String
  role        Role      @default(MEMBER)
  tokenHash   String    @unique
  expiresAt   DateTime
  invitedById String
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
}

model Cycle {
  id             String   @id @default(cuid())
  teamId         String
  name           String
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(false)
  capacityPoints Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  issues      Issue[]
  statusRules StatusRule[]
  snapshots   CycleSnapshot[]

  @@index([teamId])
}

model WorkflowStatus {
  id           String             @id @default(cuid())
  teamId       String
  key          String
  name         String
  type         WorkflowStatusType
  position     Int                @default(0)
  color        String             @default("#94a3b8")
  statusRuleId String?

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  issues     Issue[]
  statusRule StatusRule? @relation(fields: [statusRuleId], references: [id], onDelete: SetNull)

  @@unique([teamId, key])
  @@index([teamId])
  @@index([statusRuleId])
}

model Initiative {
  id         String           @id @default(cuid())
  teamId     String
  name       String
  targetDate DateTime?
  health     InitiativeHealth @default(ON_TRACK)
  createdAt  DateTime         @default(now())

  parentId  String?
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parent    Initiative?  @relation("InitiativeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Initiative[] @relation("InitiativeTree")
  projects  Project[]
  documents Document[]

  @@index([teamId])
  @@index([parentId])
}

model Label {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  color     String   @default("#0f766e")
  group     String?
  createdAt DateTime @default(now())

  team             Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  issues           IssueLabel[]
  triageMatchRules TriageRule[]    @relation("TriageMatchLabel")
  triageAddRules   TriageRule[]    @relation("TriageAddLabel")
  statusAddRules   StatusRule[]    @relation("StatusAddLabel")
  templates        IssueTemplate[]

  @@unique([teamId, name])
  @@index([teamId])
}

model IssueLabel {
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
}

model Project {
  id           String        @id @default(cuid())
  teamId       String
  workspaceId  String?
  name         String
  summary      String        @default("") @db.Text
  status       ProjectStatus @default(BACKLOG)
  leadId       String?
  startDate    DateTime?
  targetDate   DateTime?
  revision     Int           @default(0)
  initiativeId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  team       Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workspace  Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  initiative Initiative?     @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  lead       User?           @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  milestones Milestone[]
  issues     Issue[]
  updates    ProjectUpdate[]
  documents  Document[]

  @@index([teamId])
  @@index([workspaceId])
  @@index([initiativeId])
}

model Milestone {
  id         String    @id @default(cuid())
  projectId  String
  name       String
  targetDate DateTime?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
}

model Issue {
  id               String      @id @default(cuid())
  teamId           String
  number           Int
  title            String
  description      String      @default("") @db.Text
  status           IssueStatus @default(BACKLOG)
  priority         Priority    @default(NONE)
  estimate         Estimate    @default(NONE)
  dueDate          DateTime?
  triageAt         DateTime?
  order            Float       @default(0)
  revision         Int         @default(0)
  assigneeId       String?
  cycleId          String?
  projectId        String?
  milestoneId      String?
  workflowStatusId String?
  creatorId        String
  archivedAt       DateTime?
  archivedById     String?
  parentId         String?
  startedAt        DateTime?
  completedAt      DateTime?
  canceledAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  team           Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee       User?               @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  cycle          Cycle?              @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone      Milestone?          @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  workflowStatus WorkflowStatus?     @relation(fields: [workflowStatusId], references: [id], onDelete: SetNull)
  creator        User                @relation("IssueCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  labels         IssueLabel[]
  comments       Comment[]
  notifications  Notification[]
  subscriptions  IssueSubscription[]
  agentClaim     AgentClaim?
  relationsFrom  IssueRelation[]     @relation("RelationFrom")
  relationsTo    IssueRelation[]     @relation("RelationTo")
  attachments    Attachment[]
  activities     IssueActivity[]
  links          IssueLink[]
  requests       CustomerRequest[]
  releases       IssueRelease[]
  presence       IssuePresence[]
  parent         Issue?              @relation("IssueParent", fields: [parentId], references: [id], onDelete: SetNull)
  children       Issue[]             @relation("IssueParent")

  @@unique([teamId, number])
  @@index([cycleId, completedAt])
  @@index([parentId])
  @@index([teamId, archivedAt])
  @@index([teamId, status])
  @@index([teamId, cycleId])
  @@index([teamId, order])
  @@index([teamId, updatedAt])
  @@index([teamId, assigneeId, status])
  @@index([teamId, projectId, status])
  @@index([assigneeId])
  @@index([projectId])
  @@index([workflowStatusId])
}

model IssueRelation {
  id          String       @id @default(cuid())
  fromIssueId String
  toIssueId   String
  type        RelationType
  createdAt   DateTime     @default(now())

  fromIssue Issue @relation("RelationFrom", fields: [fromIssueId], references: [id], onDelete: Cascade)
  toIssue   Issue @relation("RelationTo", fields: [toIssueId], references: [id], onDelete: Cascade)

  @@unique([fromIssueId, toIssueId, type])
  @@index([toIssueId])
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue     Issue             @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions CommentReaction[]
  parent    Comment?          @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentThread")
  parentId  String?

  @@index([issueId, createdAt])
  @@index([parentId])
}

model CommentReaction {
  id        String @id @default(cuid())
  commentId String
  userId    String
  emoji     String

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
}

model Attachment {
  id          String   @id @default(cuid())
  issueId     String
  url         String
  name        String
  size        Int
  contentType String
  createdById String
  createdAt   DateTime @default(now())

  issue     Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model IssueSubscription {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@index([userId])
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  teamId       String
  issueId      String?
  type         NotificationType
  title        String
  body         String           @default("")
  readAt       DateTime?
  snoozedUntil DateTime?
  createdAt    DateTime         @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue Issue? @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model SavedView {
  id         String     @id @default(cuid())
  teamId     String
  name       String
  filterJson Json
  layout     ViewLayout @default(LIST)
  pinned     Boolean    @default(true)
  shared     Boolean    @default(true)
  ownerId    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([ownerId])
}

/// One row per cycle per day: how much scope there was and how much was finished by the end of
/// that day. A burndown is read straight from these, so it does not change if issues are edited
/// or moved later.
model CycleSnapshot {
  cycleId       String
  day           DateTime
  scopePoints   Int      @default(0)
  scopeIssues   Int      @default(0)
  donePoints    Int      @default(0)
  doneIssues    Int      @default(0)
  startedIssues Int      @default(0)

  cycle Cycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@id([cycleId, day])
}

model MutationReceipt {
  id               String   @id @default(cuid())
  teamId           String
  clientMutationId String
  issueId          String?
  createdAt        DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, clientMutationId])
  @@index([teamId])
}

model IssueDeletion {
  issueId   String   @id
  teamId    String
  deletedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, deletedAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  teamId      String
  name        String
  keyHash     String
  prefix      String
  role        Role      @default(MEMBER)
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  oauthAppId  String?
  createdAt   DateTime  @default(now())

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  oauthApp  OAuthApp? @relation(fields: [oauthAppId], references: [id], onDelete: Cascade)

  @@index([prefix])
  @@index([teamId])
  @@index([oauthAppId])
}

model Webhook {
  id          String    @id @default(cuid())
  teamId      String
  url         String
  secret      String
  events      String[]
  createdById String
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())

  team       Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy  User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([teamId])
}

model ProjectUpdate {
  id        String           @id @default(cuid())
  projectId String
  authorId  String
  body      String           @db.Text
  health    InitiativeHealth @default(ON_TRACK)
  createdAt DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model IssueTemplate {
  id          String   @id @default(cuid())
  teamId      String
  name        String
  title       String
  description String   @default("") @db.Text
  priority    Priority @default(NONE)
  estimate    Estimate @default(NONE)
  labelId     String?
  label       Label?   @relation(fields: [labelId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([labelId])
}

model IssueActivity {
  id        String   @id @default(cuid())
  issueId   String
  actorId   String
  field     String
  fromValue String   @default("")
  toValue   String   @default("")
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
}

model Document {
  id          String   @id @default(cuid())
  teamId      String
  title       String
  body        String   @default("") @db.Text
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId    String?
  initiativeId String?
  team         Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  updatedBy    User               @relation(fields: [updatedById], references: [id], onDelete: Cascade)
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  initiative   Initiative?        @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  comments     DocumentComment[]
  revisions    DocumentRevision[]

  @@index([teamId])
  @@index([projectId])
  @@index([initiativeId])
}

/// A snapshot of a document taken just before it was overwritten, so edits can be compared with
/// and restored. At most the newest 50 per document are kept.
model DocumentRevision {
  id         String   @id @default(cuid())
  documentId String
  title      String
  body       String   @db.Text
  authorId   String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
}

model Customer {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  domain    String   @default("")
  createdAt DateTime @default(now())

  team     Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requests CustomerRequest[]

  @@index([teamId])
}

model CustomerRequest {
  id         String   @id @default(cuid())
  customerId String
  issueId    String?
  body       String   @db.Text
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  issue    Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([customerId])
}

model IssueLink {
  id          String   @id @default(cuid())
  issueId     String
  kind        String
  url         String
  title       String   @default("")
  description String   @default("")
  createdAt   DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model Pipeline {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  team     Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  stages   PipelineStage[]
  releases Release[]

  @@index([teamId])
}

model Release {
  id         String    @id @default(cuid())
  teamId     String
  pipelineId String?
  stageId    String?
  name       String
  targetDate DateTime?
  createdAt  DateTime  @default(now())

  team     Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  pipeline Pipeline?      @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stage    PipelineStage? @relation("ReleaseStage", fields: [stageId], references: [id], onDelete: SetNull)
  issues   IssueRelease[]

  @@index([teamId])
  @@index([pipelineId])
  @@index([stageId])
}

model PipelineStage {
  id         String  @id @default(cuid())
  teamId     String
  pipelineId String?
  name       String
  position   Int     @default(0)

  team     Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  pipeline Pipeline?      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  issues   IssueRelease[]
  releases Release[]      @relation("ReleaseStage")

  @@unique([pipelineId, name])
  @@index([teamId])
  @@index([pipelineId])
}

model IssueRelease {
  issueId   String
  releaseId String
  stageId   String?

  issue   Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  release Release        @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  stage   PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@id([issueId, releaseId])
  @@index([releaseId])
  @@index([stageId])
}

model SavedInsight {
  id         String   @id @default(cuid())
  teamId     String
  name       String
  filterJson Json
  createdAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model StatusRule {
  id            String      @id @default(cuid())
  teamId        String
  position      Int         @default(0)
  fromStatus    IssueStatus
  setAssigneeId String?
  addLabelId    String?
  setPriority   Priority?
  setCycleId    String?
  commentBody   String      @default("")
  createdAt     DateTime    @default(now())

  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  setAssignee User?            @relation("StatusAssignee", fields: [setAssigneeId], references: [id], onDelete: SetNull)
  addLabel    Label?           @relation("StatusAddLabel", fields: [addLabelId], references: [id], onDelete: SetNull)
  setCycle    Cycle?           @relation(fields: [setCycleId], references: [id], onDelete: SetNull)
  workflows   WorkflowStatus[]

  @@index([teamId])
  @@index([setCycleId])
}

model IssuePresence {
  issueId String
  userId  String
  seenAt  DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@index([seenAt])
}

model TriageRule {
  id            String       @id @default(cuid())
  teamId        String
  position      Int          @default(0)
  titleContains String       @default("")
  priority      Priority?
  labelId       String?
  setAssigneeId String?
  setStatus     IssueStatus?
  addLabelId    String?
  createdAt     DateTime     @default(now())

  team        Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  label       Label? @relation("TriageMatchLabel", fields: [labelId], references: [id], onDelete: SetNull)
  addLabel    Label? @relation("TriageAddLabel", fields: [addLabelId], references: [id], onDelete: SetNull)
  setAssignee User?  @relation("TriageAssignee", fields: [setAssigneeId], references: [id], onDelete: SetNull)

  @@index([teamId])
}

model DocumentComment {
  id         String   @id @default(cuid())
  documentId String
  authorId   String
  body       String   @db.Text
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

/// A user's starred item, shown in the sidebar. `kind` is issue | project | cycle | doc | view |
/// initiative; `targetId` is that row's id. `folder` groups favorites in the sidebar.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  kind      String
  targetId  String
  folder    String?
  position  Float    @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId, kind, targetId])
  @@index([userId, teamId, position])
}

/// Shared rate-limit counters so limits hold across serverless instances.
model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

/// SAML assertion ids and request ids already seen, so a captured response can't be replayed.
/// `key` is "assertion:<id>" or "request:<id>".
model SamlSeen {
  key       String   @id
  value     String   @default("")
  expiresAt DateTime

  @@index([expiresAt])
}

/// Who did what to the team's settings, members, keys and hooks. `actorId` has no foreign key and
/// `actorLabel` is a snapshot, so the trail survives the person being removed or deleted.
model AuditLog {
  id         String   @id @default(cuid())
  teamId     String
  actorId    String?
  actorLabel String   @default("")
  action     String
  targetType String   @default("")
  targetId   String?
  summary    String   @default("")
  metadata   Json?
  createdAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([teamId, action])
}

/// Which notification types a person has muted (in the inbox). One row per user, no row = nothing muted.
model NotificationPreference {
  userId     String             @id
  mutedTypes NotificationType[]
  updatedAt  DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// An unfinished new issue, private to its author. `fields` holds whatever the create form had
/// (title, description, priority, assignee id, ...) and is validated again when it is published.
model IssueDraft {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  title     String   @default("")
  fields    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId, userId, updatedAt])
}

/// "When <trigger> and <conditions>, do <actions>". `conditions` is an issue filter tree (the same
/// shape as saved views); `actions` is a validated list (see lib/automations.ts). Actions are applied
/// straight to the database, never through updateIssue, so an automation cannot trigger itself.
model Automation {
  id          String    @id @default(cuid())
  teamId      String
  name        String
  enabled     Boolean   @default(true)
  trigger     String
  conditions  Json?
  actions     Json
  position    Int       @default(0)
  runCount    Int       @default(0)
  lastRunAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([teamId, enabled, trigger])
}

/// Two-factor sign-in (TOTP) for password logins. `secret` is AES-GCM encrypted, `recoveryHashes`
/// are SHA-256 hashes (a used code is removed), and `lastStep` stops a code being used twice.
/// `enabledAt` stays null until the first valid code proves the app is set up.
model TwoFactor {
  userId         String    @id
  secret         String
  recoveryHashes String[]
  lastStep       Int       @default(0)
  enabledAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// An app that signs people in to Verk through OAuth (authorization code + PKCE). Registered by a
/// team admin. `clientSecretHash` is null for public clients (native or browser apps) that rely on
/// PKCE alone. Access tokens are ordinary API keys linked back here, so revoking the app revokes them.
model OAuthApp {
  id               String   @id @default(cuid())
  teamId           String
  name             String
  clientId         String   @unique
  clientSecretHash String?
  redirectUris     String[]
  createdById      String?
  createdAt        DateTime @default(now())

  team    Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  codes   OAuthCode[]
  apiKeys ApiKey[]

  @@index([teamId])
}

/// A one-time authorization code, valid for 10 minutes. Stored only as a hash.
model OAuthCode {
  codeHash      String   @id
  appId         String
  userId        String
  redirectUri   String
  codeChallenge String
  scope         String
  expiresAt     DateTime

  app OAuthApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// One attempt history per (webhook, event). `status` is pending (will retry), delivered, or failed
/// (gave up). Bodies are kept so a failed delivery can be retried or replayed. Pruned after 14 days.
model WebhookDelivery {
  id            String    @id @default(cuid())
  teamId        String
  webhookId     String
  event         String
  body          String    @db.Text
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastCode      Int?
  lastError     String?
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
}

/// A public "ask the team" link. Anyone with the token can submit a request (title, details and
/// optionally a name and email); it lands in the team's triage queue. The token is stored hashed, shown
/// once, and can be rotated or switched off.
model AskLink {
  teamId    String   @id
  tokenHash String   @unique
  prefix    String
  enabled   Boolean  @default(true)
  heading   String   @default("")
  createdAt DateTime @default(now())
  rotatedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

/// A saved insights query: measure by dimension over issues matching an optional filter. Shared
/// reports are visible to the whole team; private ones only to their author.
model InsightReport {
  id        String   @id @default(cuid())
  teamId    String
  ownerId   String?
  name      String
  measure   String
  dimension String
  filter    String   @default("")
  shared    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([teamId, shared])
  @@index([ownerId])
}

/// A WebAuthn passkey. Signing in with one needs the device plus a local unlock (biometrics or PIN),
/// so it counts as two factors on its own. The public key is not a secret; only the device holds the
/// private key.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  transports   String[]
  deviceType   String    @default("")
  backedUp     Boolean   @default(false)
  name         String    @default("")
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A coding agent working on an issue. One row per issue: a lease the agent keeps alive with
/// heartbeats, so an agent that crashes frees the issue when the lease runs out. `result` and
/// `note` are what the agent reported back.
model AgentClaim {
  issueId        String   @id
  teamId         String
  agentUserId    String
  state          String   @default("active")
  leaseExpiresAt DateTime
  note           String   @default("")
  resultUrl      String   @default("")
  claimedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  agent User  @relation(fields: [agentUserId], references: [id], onDelete: Cascade)

  @@index([agentUserId, state])
  @@index([teamId, state])
}
