# --- Required: all four must be set ---
# Neon pooled connection. App runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon direct connection. Prisma migrate.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Auth.js secret. openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# App origin (local or production). Invite links and OAuth callbacks.
AUTH_URL="http://localhost:3000"

# --- GitHub sign-in (OAuth App → Authorization callback URL: {AUTH_URL}/api/auth/callback/github) ---
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Optional. Comma-separated GitHub usernames or numeric account ids.
# When set, only those GitHub accounts can use the app. Leave empty so a self-hosted deploy can sign up its own users.
AUTH_ALLOWED_GITHUB=""

# --- Team invite emails (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="Verk <onboarding@resend.dev>"

# --- Issue file attachments (Vercel Blob). Max 10 MB: png, jpeg, gif, webp, pdf, text, markdown, zip. ---
BLOB_READ_WRITE_TOKEN=""

# --- Offline outbox (omit or "true" to enable; "false" disables) ---
NEXT_PUBLIC_PWA_OFFLINE="true"

# Lock destructive demo actions (team delete) on the public host
DEMO_MODE="false"

# Optional: Vercel Cron Authorization bearer for /api/cron/cycles
CRON_SECRET=""

# Optional: GitHub pull-request webhook (Settings → team githubRepo must match)
GITHUB_WEBHOOK_SECRET=""

# Optional: GitLab merge-request webhook (POST /api/gitlab/webhook, "Merge request events").
# Use this value as the webhook's secret token; the team's gitlabProject must match the project path.
GITLAB_WEBHOOK_SECRET=""

# Optional: comment on linked pull requests when an issue status changes
GITHUB_TOKEN=""

# Optional: demo reset (POST /api/demo/reset). Only used when DEMO_MODE=true
DEMO_RESET_SECRET=""

# Optional: Capacitor shell loads this URL (defaults to https://verk.rejisterjack.com)
CAPACITOR_SERVER_URL=""

# Optional Google sign-in
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional enterprise SSO (OIDC)
AUTH_OIDC_ISSUER=""
AUTH_OIDC_CLIENT_ID=""
AUTH_OIDC_CLIENT_SECRET=""

# Optional SAML 2.0 single sign-on (built for Google Workspace; any SAML 2.0 IdP works).
# In the Google Admin console: Apps -> Web and mobile apps -> Add custom SAML app.
#   Google gives you the SSO URL, Entity ID and certificate below.
#   Give Google these two values (also at {AUTH_URL}/api/auth/saml/metadata):
#     ACS URL   {AUTH_URL}/api/auth/saml/acs
#     Entity ID {AUTH_URL}/api/auth/saml/metadata   (or your SAML_SP_ENTITY_ID)
#   Name ID format: EMAIL. Name ID: Basic Information > Primary email.
# SAML turns on only when SAML_IDP_SSO_URL and SAML_IDP_CERT are both set.
SAML_IDP_SSO_URL=""
SAML_IDP_CERT=""
# Optional. Google's "Entity ID" (the IdP issuer). Set it to also pin the issuer.
SAML_IDP_ISSUER=""
# Optional. Defaults to {AUTH_URL}/api/auth/saml/metadata
SAML_SP_ENTITY_ID=""
# Optional. Attribute holding the email / display name. Defaults to the NameID.
SAML_EMAIL_ATTRIBUTE=""
SAML_NAME_ATTRIBUTE=""
# Optional. Comma-separated email domains allowed to sign in, e.g. "acme.com".
# Empty allows any domain your IdP vouches for.
SAML_ALLOWED_DOMAINS=""

# Optional SCIM bearer for /api/scim/Users and /api/scim/Groups
# A SCIM group is a Verk team: /Groups/{team id}. Members are matched by user id.
# SCIM links to existing teams. It never creates one.
SCIM_TOKEN=""

# Optional bearer for POST /api/teams/{teamId}/intake (create an issue from an outside form)
INTAKE_TOKEN=""

# Optional Slack app. See docs/slack-app-manifest.json
#   Slash command  POST {AUTH_URL}/api/slack/command
#   Events         POST {AUTH_URL}/api/slack/events        (subscribe to app_mention)
#   Interactivity  POST {AUTH_URL}/api/slack/interactivity (message shortcut "verk_create_issue")
# Map a Slack workspace/channel to a team in Team settings (Slack workspace id / channel id).
# Slack users act as the Verk member with the same email, with that member's role.
SLACK_SIGNING_SECRET=""
SLACK_BOT_TOKEN=""
# Fallback team when no Slack workspace is mapped in Team settings.
SLACK_TEAM_SLUG=""
# Fallback channel for bot messages when a team has no channel id.
SLACK_CHANNEL=""

# Optional issue agent POST /api/agent (Bearer verk_… plus teamId and prompt)
AI_API_KEY=""
AI_API_URL=""
AI_MODEL=""

# Optional smoke scripts (npm run mcp:smoke, npm run scim:smoke)
VERK_BASE_URL=""
VERK_API_KEY=""
SCIM_TEAM_NAME=""