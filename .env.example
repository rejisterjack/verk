# --- Required: all four must be set ---
# Neon pooled connection. App runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon direct connection. Prisma migrate.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Auth.js secret. openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# App origin (local or production). Invite links and OAuth callbacks.
AUTH_URL="http://localhost:3000"

# --- GitHub sign-in (OAuth App → Authorization callback URL: {AUTH_URL}/api/auth/callback/github) ---
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Team invite emails (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="Verk <onboarding@resend.dev>"

# --- Issue file attachments (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- Offline outbox (omit or "true" to enable; "false" disables) ---
NEXT_PUBLIC_PWA_OFFLINE="true"

# Lock destructive demo actions (team delete) on the public host
DEMO_MODE="false"

# Optional: Vercel Cron Authorization bearer for /api/cron/cycles
CRON_SECRET=""

# Optional: GitHub pull-request webhook (Settings → team githubRepo must match)
GITHUB_WEBHOOK_SECRET=""

# Optional: comment on linked pull requests when an issue status changes
GITHUB_TOKEN=""

# Optional: demo reset (POST /api/demo/reset). Only used when DEMO_MODE=true
DEMO_RESET_SECRET=""

# Optional: Capacitor shell loads this URL (defaults to https://verk.rejisterjack.com)
CAPACITOR_SERVER_URL=""

# Optional Google sign-in
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional enterprise SSO (OIDC; use this for a SAML IdP that exposes OIDC)
AUTH_OIDC_ISSUER=""
AUTH_OIDC_CLIENT_ID=""
AUTH_OIDC_CLIENT_SECRET=""

# Optional SCIM bearer for /api/scim/Users
SCIM_TOKEN=""
