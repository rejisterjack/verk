# --- Required (app + migrations) ---
# Neon: pooled for runtime, direct for Prisma migrate
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js — openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# App origin (local or production). Used for invite links and OAuth callbacks.
AUTH_URL="http://localhost:3000"

# --- GitHub sign-in (OAuth App → Authorization callback URL: {AUTH_URL}/api/auth/callback/github) ---
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Team invite emails (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="Verk <onboarding@resend.dev>"

# --- Issue file attachments (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- Offline outbox (omit or "true" to enable; "false" disables) ---
NEXT_PUBLIC_PWA_OFFLINE="true"
