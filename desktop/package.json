{
  "name": "verk-desktop",
  "version": "0.1.0",
  "description": "Desktop shell for Verk",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.rejisterjack.verk.desktop",
    "productName": "Verk",
    "files": ["main.js", "package.json"],
    "mac": { "category": "public.app-category.productivity" },
    "linux": { "target": ["AppImage"], "category": "Office" },
    "win": { "target": ["nsis"] }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}